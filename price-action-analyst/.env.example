# Copy to .env for local development. Never commit real secrets.
# In production set these in Netlify: Site configuration -> Environment variables.

# --- App ---------------------------------------------------------------------
# production | development | test  (if unset, the app assumes production and requires real secrets)
APP_ENV=development
# public URL of the site (required in production, used for origin checks)
APP_URL=http://localhost:5173
# 32+ random chars. Generate: openssl rand -base64 48
AUTH_SECRET=
SESSION_TTL_HOURS=168
# set false after creating your account(s)
REGISTRATION_ENABLED=true
# optional: required at sign-up when set
REGISTRATION_INVITE_CODE=

# --- Database (PostgreSQL) ---------------------------------------------------
# postgres in production; memory = local only, data lost on restart
DB_DRIVER=memory
# e.g. postgres://user:pass@host/db?sslmode=require (use the POOLED URL on Neon)
DATABASE_URL=
# create/upgrade tables automatically on first use
AUTO_MIGRATE=true

# --- Storage for uploaded screenshots ----------------------------------------
# netlify (production) | fs (local) | memory (tests)
STORAGE_DRIVER=fs
FS_STORAGE_DIR=.data/uploads

# --- AI (vision model) --------------------------------------------------------
# gemini = Google Gemini free tier (default in production) | anthropic = Claude (paid) | mock = fake results, local only
AI_PROVIDER=mock
# Free key from https://aistudio.google.com -> Get API key (no credit card)
GEMINI_API_KEY=
# A current free-tier Flash model; "gemini-flash-latest" always points to the newest Flash
GEMINI_MODEL=gemini-flash-latest

# Optional paid alternative: Anthropic Claude
# from console.anthropic.com -> API keys. Server-side only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = deeper + slower + costlier)
ANTHROPIC_EFFORT=high
ANTHROPIC_MAX_TOKENS=32000
# server-side fallback model if the primary declines a request
ANTHROPIC_FALLBACKS=true
# override cost estimates (USD per million tokens)
# AI_PRICE_INPUT_PER_MTOK=4
# AI_PRICE_OUTPUT_PER_MTOK=20

# --- Job execution -----------------------------------------------------------
# inline = run inside the API request (default; works on Netlify's free plan, ~60 s limit)
# background = Netlify Background Function (15 min) | async = local Node server only
ANALYSIS_EXECUTION=async
# 32+ random chars; required for background mode
INTERNAL_JOB_SECRET=

# --- Limits & cost control ---------------------------------------------------
RATE_LIMIT_ANALYSES_PER_HOUR=10
RATE_LIMIT_ANALYSES_PER_DAY=40
# optional hard stop for the whole app, e.g. 50
MONTHLY_BUDGET_USD=
LOGIN_ATTEMPTS_PER_15_MIN=10
DUPLICATE_WINDOW_HOURS=24
MAX_IMAGES=6
MAX_IMAGE_BYTES=1500000
MAX_TOTAL_UPLOAD_BYTES=4500000
MIN_IMAGE_DIMENSION=300
