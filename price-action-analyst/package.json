{
  "name": "price-action-analyst",
  "version": "1.0.0",
  "private": true,
  "description": "AI price-action chart analysis assistant. Analysis only - never places trades.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/dev-server.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --env-file-if-exists=.env --import tsx e2e/run-e2e.ts",
    "db:migrate": "tsx --env-file-if-exists=.env server/scripts/migrate.ts",
    "analyze:file": "tsx --env-file-if-exists=.env server/scripts/analyze-file.ts",
    "charts:generate": "tsx e2e/generate-charts.ts",
    "build:instant": "vite build --config vite.artifact.config.ts && node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@netlify/blobs": "^11.1.3",
    "hono": "^4.13.13",
    "image-size": "^2.0.4",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.3",
    "@netlify/functions": "^6.0.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
