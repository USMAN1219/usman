# Anthropic Console se API key: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Telegram par @BotFather se naya bot bana kar token yahan dalein
TELEGRAM_BOT_TOKEN=123456:ABC...

# Sirf yeh Telegram user IDs bot use kar sakein (comma separated).
# Apni ID @userinfobot se pata karein. Khali chhorne par koi bhi use kar sakta hai (API ka kharcha aap ka!).
ALLOWED_USER_IDS=

# Optional
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high
DATA_DIR=data
